<?xml version="1.0" encoding="utf-8"?>
<!--
  App widgets are RemoteViews: no custom views, so the dial's ring cannot be
  drawn here. It is rendered to a bitmap in the app process and set on the
  ImageView instead, and the controls are buttons because a widget only ever
  receives clicks — there is no way to track a rotary swipe.

  Sized for a 4x2 home-screen cell, which is about 250x110dp. That is much less
  room than it sounds: the five controls are spread by weight so they stay
  circular at any width, and the volume readout shares the zone's line rather
  than competing with them for the bottom row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_artwork"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_zone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#98A3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_volume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textColor="#7AC8FF"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F2F5F8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#98A3AF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_previous"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_button_background"
                android:contentDescription="@string/widget_previous"
                android:padding="7dp"
                android:src="@drawable/ic_widget_previous" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_button_background"
                android:contentDescription="@string/widget_play_pause"
                android:padding="7dp"
                android:src="@drawable/ic_widget_play" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_button_background"
                android:contentDescription="@string/widget_next"
                android:padding="7dp"
                android:src="@drawable/ic_widget_next" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_volume_down"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_button_background"
                android:contentDescription="@string/widget_volume_down"
                android:padding="7dp"
                android:src="@drawable/ic_widget_volume_down" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_volume_up"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_button_background"
                android:contentDescription="@string/widget_volume_up"
                android:padding="7dp"
                android:src="@drawable/ic_widget_volume_up" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
